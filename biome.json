{
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.worktrees",
      "!**/drizzle",
      "!packages/impression/.claude-plugin",
      "!packages/impression/.codex-plugin",
      "!packages/impression/hooks",
      "!packages/impression/.mcp.json",
      "!packages/impression/pi"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
