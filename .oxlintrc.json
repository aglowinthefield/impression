{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/purity": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "unicorn/no-new-array": "off",
    "vitest/require-to-throw-message": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/drizzle/**",
    ".worktrees/**",
    "packages/impression/.claude-plugin/**",
    "packages/impression/.codex-plugin/**",
    "packages/impression/hooks/**",
    "packages/impression/pi/**"
  ]
}
