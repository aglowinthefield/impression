{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    ".worktrees",
    "**/drizzle",
    "packages/impression/.claude-plugin",
    "packages/impression/.codex-plugin",
    "packages/impression/hooks",
    "packages/impression/.mcp.json",
    "packages/impression/pi",
    "**/*.md"
  ],
  "sortPackageJson": false
}
