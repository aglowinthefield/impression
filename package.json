{
  "name": "impression",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@impression/api",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "vitest": "^5.1.0"
  }
}
