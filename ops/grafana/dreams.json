{
  "uid": "impression-dreams",
  "title": "Impression \u00b7 Dreams",
  "tags": [
    "impression"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "impression-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": "select p.name as __text, p.id::text as __value from projects p where exists (select 1 from dream_runs d where d.project_id = p.id) order by 1",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Failed runs",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) filter (where d.error is not null) from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at)"
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Dream cost",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(d.cost_micros),0)/1e6 from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at)"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Since last run",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select extract(epoch from now() - max(d.started_at)) from dream_runs d where d.project_id::text in (${project:sqlstring})"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "The schedule runs at least daily when anything changed; over 26h with changes means it stalled."
    },
    {
      "id": 5,
      "title": "Concepts now",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) from concepts c where c.project_id::text in (${project:sqlstring})"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "title": "Uncategorized now",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(u),0) from (select distinct on (d.project_id, d.owner) d.uncategorized u from dream_runs d where d.project_id::text in (${project:sqlstring}) and d.error is null and d.finished_at is not null order by d.project_id, d.owner, d.started_at desc) x"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Memories left out of every concept, from each person and project's latest run."
    },
    {
      "id": 7,
      "title": "Runs per day by trigger",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(d.started_at, 1d), d.trigger as metric, count(*) as value from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) group by 1,2 order by 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Cost per day by project",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(d.started_at, 1d), p.name as metric, sum(d.cost_micros)/1e6 as value from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) group by 1,2 order by 1"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 6,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Run duration",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select d.started_at as time, p.name as metric, extract(epoch from d.finished_at - d.started_at) as value from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) and d.finished_at is not null order by 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Uncategorized per run",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select d.started_at as time, p.name as metric, d.uncategorized as value from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) and d.error is null order by 1"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Concepts per run",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select d.started_at as time, p.name as metric, d.concepts as value from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) and d.error is null order by 1"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Total concepts after each run. Churn (created/removed) is in the table below."
    },
    {
      "id": 12,
      "title": "Model cost by operation (Fly metrics)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fly-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fly-prom"
          },
          "expr": "sum by (operation) (increase(impression_model_cost_micro_usd_total{app=\"impression-cool-ocean-6435\"}[1h])) / 1e6",
          "legendFormat": "{{operation}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "description": "Hourly model spend across all operations, from the API's /metrics. Counters reset on deploy."
    },
    {
      "id": 13,
      "title": "Latest runs",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "impression-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "impression-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select d.started_at as \"Started\", p.name as \"Project\", d.owner as \"Owner\", d.trigger as \"Trigger\", extract(epoch from d.finished_at - d.started_at) as \"Duration\", d.memories as \"Memories\", d.concepts as \"Concepts\", d.created as \"Created\", d.kept as \"Kept\", d.removed as \"Removed\", d.uncategorized as \"Uncategorized\", d.cost_micros/1e6 as \"Cost\", d.model as \"Model\", d.error as \"Error\" from dream_runs d join projects p on p.id = d.project_id where d.project_id::text in (${project:sqlstring}) and $__timeFilter(d.started_at) order by d.started_at desc limit 100"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ]
      }
    }
  ]
}