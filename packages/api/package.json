{
  "name": "@impression/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "typecheck": "tsrs -p . --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@impression/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4",
    "postgres": "^3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
