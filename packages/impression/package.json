{
  "name": "@aglowinthefield/impression",
  "version": "0.2.1",
  "description": "Memory for coding agents: CLI, MCP server, and plugins for Claude Code, Codex and pi",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aglowinthefield/impression.git",
    "directory": "packages/impression"
  },
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/aglowinthefield/impression#readme",
  "bin": {
    "impression": "dist/impression.js",
    "impression-mcp": "dist/impression-mcp.js"
  },
  "files": [
    "dist",
    "pi",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./pi/impression.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@impression/cli": "workspace:*",
    "@impression/mcp": "workspace:*",
    "@impression/shared": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
